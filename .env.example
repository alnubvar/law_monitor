# AHSTEP law_monitor environment template.
# Copy this file to the real env location and fill values there.
# Do not commit real secrets, chat IDs, tokens, or proxy credentials.
#
# Local development defaults still work if these path values are left unset:
# data/, reports/, and logs/ inside the repository.
#
# Linux production example:
# LAW_MONITOR_DATA_DIR=/var/lib/ahstep-law-monitor/data
# LAW_MONITOR_REPORTS_DIR=/var/lib/ahstep-law-monitor/reports
# LAW_MONITOR_BACKUP_DIR=/var/lib/ahstep-law-monitor/backups
# LAW_MONITOR_TMP_DIR=/var/lib/ahstep-law-monitor/tmp
# LAW_MONITOR_LOG_DIR=/var/log/ahstep-law-monitor
# LAW_MONITOR_DB_PATH=/var/lib/ahstep-law-monitor/data/law_monitor.db
# LAW_MONITOR_LOG_FILE=/var/log/ahstep-law-monitor/app.log

TELEGRAM_BOT_TOKEN=
# Optional legacy/fallback scheduled destination. Private users do not need a group chat.
TELEGRAM_CHAT_ID=
# Emergency/replacement bot admins for private commands. Numeric Telegram user IDs only.
TELEGRAM_ADMIN_USER_IDS=
# Optional initial private-user allowlist seed. Manage live access via admin bot commands.
TELEGRAM_ALLOWED_USER_IDS=
# Production default: keep automatic urgent alerts quiet; daily digest still includes urgent items.
TELEGRAM_URGENT_ALERTS_ENABLED=false
# Visible Telegram command menu: /start, /myid, /help, /report, /refresh.
# Search stays available through the bottom "🔎 Поиск" button.
# Reports are archived on server as .md and sent to Telegram users as editable .docx.

# Telegram proxy is used only for Telegram Bot API calls.
# To change it later, edit the real env file and restart services.
# Source/network proxying is separate; use HTTPS_PROXY/HTTP_PROXY only if IT wants
# source requests to use system proxy envs.
TELEGRAM_PROXY_URL=
TELEGRAM_API_TIMEOUT=30

# Persistent production paths. Keep generated data outside the git checkout.
LAW_MONITOR_DATA_DIR=data
LAW_MONITOR_REPORTS_DIR=reports
LAW_MONITOR_BACKUP_DIR=data/backups
LAW_MONITOR_TMP_DIR=data
LAW_MONITOR_LOG_DIR=logs
LAW_MONITOR_DB_PATH=data/law_monitor.db
LAW_MONITOR_LOG_FILE=logs/app.log

LAW_MONITOR_LOG_LEVEL=INFO
LAW_MONITOR_LOG_MAX_BYTES=5242880
LAW_MONITOR_LOG_BACKUP_COUNT=5
LAW_MONITOR_TIMEZONE=Europe/Moscow

# Canonical scheduler names; SCHEDULER_INTERVAL_MINUTES and
# SCHEDULER_DAILY_REPORT_HOUR are accepted as compatibility aliases.
LAW_MONITOR_DAILY_REPORT_HOUR=9
# Recommended production quiet collection schedule before/during business day.
LAW_MONITOR_COLLECTION_TIMES=08:30,12:00,18:00
# Backward-compatible fallback when LAW_MONITOR_COLLECTION_TIMES is empty.
LAW_MONITOR_HOURLY_INTERVAL_MINUTES=360

LAW_MONITOR_OCR_ENABLED=false
LAW_MONITOR_OCR_LANGUAGE=rus+eng
LAW_MONITOR_OCR_MAX_PAGES=5
LAW_MONITOR_OCR_TIMEOUT=120
LAW_MONITOR_OCR_TESSDATA_PATH=

LAW_MONITOR_REQUEST_TIMEOUT=30
LAW_MONITOR_REQUEST_RETRIES=2
LAW_MONITOR_REQUEST_BACKOFF_FACTOR=1.0
LAW_MONITOR_USER_AGENT=law-monitor-mvp/0.1

# Deterministic AHSTEP scope gates. Defaults are compiled in; override only
# when owner explicitly expands target regions or industry profile.
# AHSTEP_TARGET_REGIONS=Россия,РФ,федеральный,Ростовская область,Краснодарский край,Ставропольский край,Московская область
# AHSTEP_EXCLUDED_TOPICS=рыбохозяйственный комплекс,аквакультура,аквакультур,рыболовство,рыбоводство,рыбохозяйственный,водные биоресурсы,корма для аквакультуры,северные олени,оленеводство,КМНС,коренные малочисленные народы,родовые общины

LLM_DOCUMENT_ENRICHMENT_ENABLED=false
# Backward-compatible alias; prefer LLM_DOCUMENT_ENRICHMENT_ENABLED for new setups.
LLM_ENRICHMENT_ENABLED=false
LLM_PROVIDER=mock
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
LLM_TIMEOUT_SECONDS=60
# Optional proxy for LLM provider HTTP requests only. Does not reuse Telegram proxy.
# Supported schemes: http, https, socks5, socks5h when requests[socks] is installed.
LLM_PROXY_URL=
# auto omits OpenAI json_object mode for Google Gemini OpenAI-compatible endpoint.
LLM_RESPONSE_FORMAT=auto
LLM_MAX_RETRIES=2
LLM_RETRY_BACKOFF_SECONDS=2
LLM_RETRY_MAX_BACKOFF_SECONDS=10
LLM_MAX_DOCUMENT_CHARS=12000
LLM_ENRICHMENT_LIMIT=20

# Production Google/Gemma via a separate LLM proxy, when approved by owner/IT:
# LLM_ENRICHMENT_ENABLED=true
# LLM_DOCUMENT_ENRICHMENT_ENABLED=true
# LLM_PROVIDER=openai_compatible
# LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
# LLM_MODEL=gemma-4-31b-it
# LLM_RESPONSE_FORMAT=none
# LLM_PROXY_URL=socks5h://USER:PASSWORD@HOST:PORT
# LLM_MAX_DOCUMENT_CHARS=1000
# LLM_TIMEOUT_SECONDS=300
# LLM_ENRICHMENT_LIMIT=3
# LLM_MAX_RETRIES=2
# LLM_RETRY_BACKOFF_SECONDS=2
# LLM_RETRY_MAX_BACKOFF_SECONDS=10
