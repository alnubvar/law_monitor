# AHSTEP law_monitor environment template.
# Copy this file to the real env location and fill values there.
# Do not commit real secrets, chat IDs, tokens, or proxy credentials.
#
# Local development defaults still work if these path values are left unset:
# data/, reports/, and logs/ inside the repository.
#
# Linux production example:
# LAW_MONITOR_DATA_DIR=/var/lib/ahstep-law-monitor/data
# LAW_MONITOR_REPORTS_DIR=/var/lib/ahstep-law-monitor/reports
# LAW_MONITOR_BACKUP_DIR=/var/lib/ahstep-law-monitor/backups
# LAW_MONITOR_TMP_DIR=/var/lib/ahstep-law-monitor/tmp
# LAW_MONITOR_LOG_DIR=/var/log/ahstep-law-monitor
# LAW_MONITOR_DB_PATH=/var/lib/ahstep-law-monitor/data/law_monitor.db
# LAW_MONITOR_LOG_FILE=/var/log/ahstep-law-monitor/app.log

TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Telegram proxy is used only for Telegram Bot API calls.
# To change it later, edit the real env file and restart services.
# Source/network proxying is separate; use HTTPS_PROXY/HTTP_PROXY only if IT wants
# source requests to use system proxy envs.
TELEGRAM_PROXY_URL=
TELEGRAM_API_TIMEOUT=30

# Persistent production paths. Keep generated data outside the git checkout.
LAW_MONITOR_DATA_DIR=data
LAW_MONITOR_REPORTS_DIR=reports
LAW_MONITOR_BACKUP_DIR=data/backups
LAW_MONITOR_TMP_DIR=data
LAW_MONITOR_LOG_DIR=logs
LAW_MONITOR_DB_PATH=data/law_monitor.db
LAW_MONITOR_LOG_FILE=logs/app.log

LAW_MONITOR_LOG_LEVEL=INFO
LAW_MONITOR_LOG_MAX_BYTES=5242880
LAW_MONITOR_LOG_BACKUP_COUNT=5
LAW_MONITOR_TIMEZONE=Europe/Moscow

# Canonical scheduler names; SCHEDULER_INTERVAL_MINUTES and
# SCHEDULER_DAILY_REPORT_HOUR are accepted as compatibility aliases.
LAW_MONITOR_DAILY_REPORT_HOUR=9
LAW_MONITOR_HOURLY_INTERVAL_MINUTES=360

LAW_MONITOR_OCR_ENABLED=false
LAW_MONITOR_OCR_LANGUAGE=rus+eng
LAW_MONITOR_OCR_MAX_PAGES=5
LAW_MONITOR_OCR_TIMEOUT=120
LAW_MONITOR_OCR_TESSDATA_PATH=

LAW_MONITOR_REQUEST_TIMEOUT=30
LAW_MONITOR_REQUEST_RETRIES=2
LAW_MONITOR_REQUEST_BACKOFF_FACTOR=1.0
LAW_MONITOR_USER_AGENT=law-monitor-mvp/0.1

LLM_DOCUMENT_ENRICHMENT_ENABLED=false
# Backward-compatible alias; prefer LLM_DOCUMENT_ENRICHMENT_ENABLED for new setups.
LLM_ENRICHMENT_ENABLED=false
LLM_PROVIDER=mock
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
LLM_TIMEOUT_SECONDS=60
LLM_MAX_DOCUMENT_CHARS=12000
LLM_ENRICHMENT_LIMIT=20
